# PostgreSQL connection string (used by Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/shichiya_blog"

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# Public site URL (used in RSS feed, sitemaps, etc.)
SITE_URL="https://shichiya.cn"

# Tencent COS for image uploads. Leave blank to store images on the local disk
# instead (the legacy behaviour, served from /uploads/).
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_REGION="ap-shanghai"
COS_MEDIA_BUCKET="shichiya-media-1258357057"
COS_PUBLIC_BASE_URL="https://img.shichiya.cn"

# Listen address — keep 127.0.0.1 in production (nginx fronts it)
HOST="127.0.0.1"
PORT=3001

NODE_ENV="development"
